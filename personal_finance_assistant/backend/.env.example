# ── Gmail IMAP ────────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=your_email_here
IMAP_PASSWORD=your_password_here

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_token_here

# ── Firebase (FCM) ────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase_service_account.json

# ── Bank Alert Filters ──────────────────────────────────────
IMAP_SEARCH_FROM=alerts@bank.com
IMAP_SEARCH_SUBJECT=transaction

# ── Scheduler ─────────────────────────────────────────────────
EMAIL_CHECK_INTERVAL_MINUTES=15
